#!/bin/bash
# Test shim: gum confirm always accepts; gum choose echoes its last positional arg.
printf '%s %s\n' "$0" "$*" >>"${SHIM_LOG:-/dev/null}"
sub="${1:-}"
shift || true
case "$sub" in
confirm) exit 0 ;;
choose)
  last=""
  for a in "$@"; do
    [[ $a == -* ]] && continue
    last="$a"
  done
  [[ -n $last ]] && printf '%s\n' "$last"
  exit 0
  ;;
*) exit 0 ;;
esac
